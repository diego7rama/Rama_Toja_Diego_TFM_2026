SC_OUT_BeltConveyor_Inclined_1 := OUT_BeltConveyor_Inclined_1;
SC_OUT_BeltConveyor_Inclined_2 := OUT_BeltConveyor_Inclined_2;
SC_OUT_BeltConveyor_Inclined_3 := OUT_BeltConveyor_Inclined_3;
SC_OUT_BeltConveyor_Inclined_4 := OUT_BeltConveyor_Inclined_4;

