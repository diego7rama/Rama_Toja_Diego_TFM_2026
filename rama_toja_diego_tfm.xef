SC_OUT_Emitter1_Emit := OUT_Emitter1_Emit;
SC_OUT_BeltConveyor_6_13 := OUT_BeltConveyor_6_13;


(* ========================================================================== *)
(* ALARMAS                                                                     *)
(* ========================================================================== *)

SC_Alarma_Emergencia := NOT Seguridad_OK;
SC_Alarma_Sistema_Detenido := NOT Marcha_General;
SC_Alarma_Sin_Permiso := NOT Permiso_Proceso;
SC_Alarma_Parada_Normal := Estado_GEMMA = 20;
SC_Alarma_Reset := Estado_GEMMA = 40;
SC_Alarma_FIFO_Lleno := SlotCount &gt;= 10;

SC_Alarma_Rack_Azul_Lleno := Position &gt;= 54;
SC_Alarma_Rack_Verde_Lleno := Position_V &gt;= 54;
SC_Alarma_Rack_F_Lleno := Position_F &gt;= 54;
SC_Alarma_Rack_NF_Lleno := Position_NF &gt;= 54;

SC_Alarma_Activa :=
	SC_Alarma_Emergencia OR
	SC_Alarma_Sin_Permiso OR
	SC_Alarma_FIFO_Lleno OR
	SC_Alarma_Rack_Azul_Lleno OR
	SC_Alarma_Rack_Verde_Lleno OR
	SC_Alarma_Rack_F_Lleno OR
	SC_Alarma_Rack_NF_Lleno;


(* ========================================================================== *)
(* IDENTIFICACIÓN Y CLASIFICACIÓN                                              *)
