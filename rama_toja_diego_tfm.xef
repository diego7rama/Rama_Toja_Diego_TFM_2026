SC_OUT_Clasificador_FnF_Plus := OUT_Pop_Up_Wheel_Sorter_4_Plus;
SC_OUT_Clasificador_FnF_Right := OUT_Pop_Up_Wheel_Sorter_4_Right;

SC_OUT_Clasificador_NF_Plus := OUT_Pop_Up_Wheel_Sorter_1_Plus;
