SC_Estado_Emergencia := Estado_GEMMA = 30;
SC_Estado_Reset := Estado_GEMMA = 40;


(* ========================================================================== *)
(* FACTORY I/O Y CINTA PRINCIPAL                                               *)
(* ========================================================================== *)

SC_FACTORY_IO_Running := IN_FACTORY_IO_Running;
SC_FACTORY_IO_Paused := IN_FACTORY_IO_Paused;
SC_FACTORY_IO_Reset := IN_FACTORY_IO_Reset;

SC_OUT_FACTORY_IO_Run := OUT_FACTORY_IO_Run;
SC_OUT_FACTORY_IO_Pause := OUT_FACTORY_IO_Pause;
