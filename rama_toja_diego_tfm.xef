	<program>
		<identProgram name="PLC_Start" type="SR" task="MAST"></identProgram>
		<LDSource nbColumns="11">
			<networkLD>
				<typeLine>
					<shortCircuit>
						<VLink></VLink>
						<contact typeContact="openContact" contactVariableName="%S21"></contact>
					</shortCircuit>
					<operateBlock width="4">
						<statement>RFID_Write_LastID :=IN_RFIDReader2CommandID;</statement>
					</operateBlock>
					<HLink nbCells="6"></HLink>
				</typeLine>
				<typeLine>
					<emptyCell nbCells="1"></emptyCell>
					<operateBlock width="4">
						<statement>RFID_Read_LastID :=IN_RFIDReader1CommandID;</statement>
					</operateBlock>
					<HLink nbCells="6"></HLink>
				</typeLine>
				<typeLine>
					<emptyLine nbRows="98"></emptyLine>
				</typeLine>
			</networkLD>
		</LDSource>
	</program>
	<program>
		<identProgram name="Activ_segunda_cinta" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Activ_segunda_cinta                                               *)
(* Cinta 2 desde Sensor 1 hasta Sensor 2  			              *)
(* ========================================================================== *)

(* CINTA 2: Se activa cuando sensor 1 detecta *)
IF IN_Diffuse_Sensor_1 THEN
	OUT_BeltConveyor_6_10 := TRUE;
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="Asignacion_fragil" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Asignacion_fragil                                                 *)
(* Las piezas al entrar en el programa no tienen valor RFID, por lo que se le *)
(* asigna uno aleatorio en esta parte del código                              *)	
(* ========================================================================== *)

R_TRIG_0 (CLK := IN_Diffuse_Sensor_1);

IF R_TRIG_0.Q AND NOT IN_Vision_Sensor_4_Bool_3 AND NOT IN_Vision_Sensor_4_Bool_2 AND NOT IN_Vision_Sensor_4_Bool_1 AND NOT IN_Vision_Sensor_4_Bool_0 
AND (SlotCount &lt; 10) THEN 

    OUT_RFID_Reader_2_Memory_Index := SlotWrite;
    OUT_RFID_Reader_2_Write_Data  := Seq[SeqIndex];
    RFID_Slots[SlotWrite] := Seq[SeqIndex];
    OUT_RFID_Reader_2_Command     := 3;
    RFID_READER_2_Executecommand  := TRUE;

        IF SeqIndex = 14 THEN
        SeqDir := -1;
    ELSIF SeqIndex = 0 THEN
        SeqDir := 1;
    END_IF;

    SeqIndex := SeqIndex + SeqDir;

        SlotWrite := (SlotWrite + 1) MOD 10;
    SlotCount := SlotCount + 1;

END_IF;

IF IN_RFIDReader2CommandID &lt;&gt; RFID_Write_LastID THEN
    RFID_READER_2_Executecommand := FALSE;
END_IF;

RFID_Write_LastID := IN_RFIDReader2CommandID;
</STSource>
	</program>
	<program>
		<identProgram name="Activ_tercera_cinta" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Activ_tercera_cinta                                               *)
(* Cinta 3 desde Sensor 2 hasta Sensor 4  			              *)
(* ========================================================================== *)

(* CINTA 3: Se activa cuando sensor 2 detecta *)

IF IN_Diffuse_Sensor_2 AND NOT IN_Vision_Sensor_1_Bool_0 AND NOT IN_Vision_Sensor_1_Bool_1 AND NOT IN_Vision_Sensor_1_Bool_2 AND NOT IN_Vision_Sensor_1_Bool_3 THEN
 OUT_BeltConveyor_6_18 := TRUE;
END_IF;

(*Aqui viene el pusher para la cinta secundaria*)

F_TRIG_67 (CLK := IN_Diffuse_Sensor_5);

IF f_TRIG_67.Q THEN
OUT_BeltConveyor_6_18 := FALSE;
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="Desvio_Pusher" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Desvío_pusher                                                     *)
(* Cuando llegan las piezas al evaluador de tipo y vemos si se desvían o no   *)
(* ========================================================================== *)


IF IN_Diffuse_Sensor_2 AND (IN_Vision_Sensor_1_Bool_0 OR IN_Vision_Sensor_1_Bool_1 OR IN_Vision_Sensor_1_Bool_2 OR IN_Vision_Sensor_1_Bool_3) THEN
		OUT_Pusher_1 := TRUE;
END_IF;

IF OUT_Pusher_1 THEN
		OUT_BeltConveyor_6_2 := TRUE;
		OUT_CurvedBeltConveyor3CCW := TRUE;
		OUT_BeltConveyor_4_4 :=TRUE ;
		OUT_BeltConveyor_4_5 :=TRUE ;
END_IF;

IF OUT_Pusher_1 THEN
	TON_5(IN := TRUE, PT := T#1.5S);
	ELSE
	TON_5(IN := FALSE); 
END_IF;

IF TON_5.Q THEN
	OUT_Pusher_1 := FALSE;
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="Lectura_RFID" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Lectura_RFID                                                      *)
(* Al pasar las cajas de cartón en la cinta principal, las lee un sensor de   *)
(* RFID para saber para donde se tienen que enviar                            *)	
(* ========================================================================== *)

R_TRIG_1 (CLK := IN_Diffuse_Sensor_5);

IF R_TRIG_1.Q AND (SlotCount &gt; 0) THEN
    (* --- Lectura RFID del slot correspondiente --- *)
    OUT_RFID_Reader_1_Memory_Index := SlotRead;
    OUT_RFID_Reader_1_Command      := 2;
    RFID_READER_1_Executecommand   := TRUE;
END_IF;

IF IN_RFIDReader1CommandID &lt;&gt; RFID_Read_LastID THEN
    RFID_READER_1_Executecommand := FALSE;

    IF IN_RFIDReader1Status = 0 THEN
        RFID_Read_Value := IN_RFIDReader1ReadData;

        (* --- Liberar slot FIFO --- *)
        SlotRead  := (SlotRead + 1) MOD 10;
        SlotCount := SlotCount - 1;
    END_IF;
END_IF;

RFID_Read_LastID := IN_RFIDReader1CommandID;
</STSource>
	</program>
	<program>
		<identProgram name="Class_F_nF" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Class_F_nF		                                              *)
(* Cuando leemos el valor del RFID, y enviamos las piezas en una de las dos   *)
(* opciones							              *)	
(* ========================================================================== *)

R_TRIG_2 (CLK := IN_Diffuse_Sensor_5);

IF R_TRIG_2.Q THEN
OUT_Pop_Up_Wheel_Sorter_4_Plus := true;
Valor_Capturado := RFID_Read_Value;   
  IF  Valor_Capturado = 0 THEN

	    OUT_BeltConveyor_6_3 := TRUE;
	    OUT_CurvedBeltConveyor1CCW :=TRUE;
    	    OUT_Pop_Up_Wheel_Sorter_4_Right := true;
	    
    ELSE    
           OUT_BeltConveyor_6_1 := true;
	   OUT_Pop_Up_Wheel_Sorter_4_Right := false;
	   
	   
	   
   END_IF;

END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="Tam_fragil" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Tam_fragil                                                        *)
(* Se evalua el tamaño de las piezas frágiles para ver si se envía o almacena *)
(* ========================================================================== *)

R_TRIG_3 (CLK := IN_Diffuse_Sensor_8);

IF R_TRIG_3.Q THEN
OUT_Pop_Up_Wheel_Sorter_3_Plus := TRUE;
   IF IN_Light_Array_Emitter_1_Value &gt; 191 THEN
	    OUT_Pop_Up_Wheel_Sorter_3_Left := TRUE;
	    OUT_BeltConveyor_6_7 := TRUE;
	    OUT_CurvedBeltConveyor4CW :=TRUE;
	    OUT_Remover_2_Remove:=TRUE;
    	  
  ELSE    
           OUT_Pop_Up_Wheel_Sorter_3_Left := FALSE;
	   OUT_BeltConveyor_6_6 := TRUE;
     	   	     
    END_IF;

END_IF;

F_TRIG_69 (CLK := IN_Diffuse_Sensor_8);

IF F_TRIG_69.Q THEN
OUT_BeltConveyor_6_1 := FALSE;
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="tam_nFragil" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: tam_nfragil                                                       *)
(* Se evalua el tamaño de las piezas no frágiles para ver si se envía o       *)
(* almacena							              *)	
(* ========================================================================== *)

R_TRIG_4 (CLK := IN_Diffuse_Sensor_3); 

IF R_TRIG_4 .Q THEN
OUT_Pop_Up_Wheel_Sorter_1_Plus := true;
OUT_CurvedBeltConveyor1CCW :=FALSE;
   IF IN_Light_Array_Emitter_2_Value &lt; 191 THEN

	    OUT_BeltConveyor_6_12 := TRUE;
	    OUT_BeltConveyor_6_15 := TRUE;
	    OUT_BeltConveyor_6_5 := TRUE;
	    OUT_CurvedBeltConveyor2CCW :=TRUE;
    	    OUT_Pop_Up_Wheel_Sorter_1_Right := TRUE;
	    OUT_BeltConveyor_2_1 := TRUE;
	    
    ELSE    
           OUT_BeltConveyor_6_4 := TRUE;
	   OUT_Pop_Up_Wheel_Sorter_1_Right := FALSE;
	   OUT_Remover_3_Remove:=TRUE;
	 	   	     
    END_IF;

END_IF;

F_TRIG_74 (CLK := IN_Diffuse_Sensor_3);

IF F_TRIG_74.Q THEN
OUT_BeltConveyor_6_3 := FALSE;
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="Pall_NF" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Pall_NF                                    	                      *)
(* La programación del palletizador de las piezas pequeñas no frágiles        *)
(* ========================================================================== *) 

R_TRIG_29 (CLK := IN_Diffuse_Sensor_7);

IF R_TRIG_29.Q THEN
	OUT_BeltConveyor_Inclined_1:=TRUE;
	OUT_Palletizer_1_Belt_Plus:=TRUE;
END_IF;

IF OUT_BeltConveyor_Inclined_1 AND OUT_Palletizer_1_Belt_Plus THEN
	TON_17 (IN := TRUE, PT := t#10S);
ELSE
	TON_17 (IN := FALSE);
END_IF;

IF TON_17.Q THEN
	OUT_BeltConveyor_Inclined_1:=FALSE;
	OUT_Palletizer_1_Belt_Plus:=FALSE;
	cont_NF:= cont_NF+1; 
END_IF;

IF cont_NF=2 THEN
	SET (OUT =&gt; OUT_Palletizer_1_Push);
	cont_NF:= 0;
	SET (OUT =&gt; OUT_Emitter2_Emit);
END_IF;

TP_18 (IN := OUT_Palletizer_1_Push,
      PT := T#2S);

F_TRIG_54 (CLK := TP_18.Q);

IF F_TRIG_54.Q THEN
	RESET (OUT =&gt; OUT_Palletizer_1_Push);
	RESET (OUT =&gt; OUT_Emitter2_Emit);
END_IF;

F_TRIG_55 (CLK := OUT_Palletizer_1_Push);

IF F_TRIG_55.Q and OUT_BeltConveyor_6_10 THEN
	SET (OUT =&gt; OUT_Pal_1_Elevator_Move_Limit);
	SET (OUT =&gt; OUT_Palletizer_1_Elevator_Plus);
	SET (OUT =&gt; OUT_Palletizer_1_Clamp);
END_IF;

TP_19 (IN := F_TRIG_55.Q,
      PT := t#2s);

F_TRIG_56 (CLK := TP_19.Q );

IF F_TRIG_56.Q AND OUT_BeltConveyor_6_10  THEN
	SET (OUT =&gt; OUT_Palletizer_1_Open_Plate);
	RESET (OUT =&gt; OUT_Palletizer_1_Clamp);
END_IF;

TP_20 (IN := OUT_Palletizer_1_Open_Plate,
      PT := T#1S);

F_TRIG_57 (CLK := TP_20.Q);

IF F_TRIG_57.Q AND OUT_BeltConveyor_6_10 THEN
	RESET (OUT =&gt; OUT_Palletizer_1_Elevator_Plus);
	SET (OUT =&gt; OUT_Palletizer_1_Elevator_Minus);
END_IF;

TP_21 (IN := OUT_Palletizer_1_Elevator_Minus,
      PT := t#2s);

F_TRIG_58 (CLK := TP_21.Q);

IF F_TRIG_58.Q AND OUT_Palletizer_1_Open_Plate THEN
	RESET (OUT =&gt; OUT_Palletizer_1_Elevator_Minus);
	RESET (OUT =&gt; OUT_Palletizer_1_Open_Plate);
	SET (OUT =&gt; OUT_Roller_Conveyor_NF);
	SET (OUT =&gt; OUT_Palletizer_1_Chain_Plus);
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="Pall_F" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Pall_F                                    	                      *)
(* La programación del palletizador de las piezas pequeñas frágiles           *)
(* ========================================================================== *) 

R_TRIG_30 (CLK := IN_Diffuse_Sensor_6);

IF R_TRIG_30.Q THEN
	OUT_BeltConveyor_Inclined_2:=TRUE;
	OUT_Palletizer_2_Belt_Plus:=TRUE;
END_IF;

IF OUT_BeltConveyor_Inclined_2 AND OUT_Palletizer_2_Belt_Plus THEN
	TON_19 (IN := TRUE, PT := t#10S);
ELSE
	TON_19 (IN := FALSE);
END_IF;

IF TON_19.Q THEN
	OUT_BeltConveyor_Inclined_2:=FALSE;
	OUT_Palletizer_2_Belt_Plus:=FALSE;
	cont_F:= cont_F+1; 
END_IF;

IF cont_F=2 THEN
	SET (OUT =&gt; OUT_Palletizer_2_Push);
	cont_F:= 0;
	SET (OUT =&gt; OUT_Emitter3_Emit);
END_IF;

TP_23 (IN := OUT_Palletizer_2_Push,
      PT := T#2S);

F_TRIG_60 (CLK := TP_23.Q);

IF F_TRIG_60.Q THEN
	RESET (OUT =&gt; OUT_Palletizer_2_Push);
	RESET (OUT =&gt; OUT_Emitter3_Emit);
END_IF;

F_TRIG_61 (CLK := OUT_Palletizer_2_Push);

IF  F_TRIG_61.Q and OUT_BeltConveyor_6_10 THEN
	SET (OUT =&gt; OUT_Pal_2_Elevator_Move_Limit);
	SET (OUT =&gt; OUT_Palletizer_2_Elevator_Plus);
	SET (OUT =&gt; OUT_Palletizer_2_Clamp);
END_IF;

TP_24 (IN := F_TRIG_61.Q,
      PT := t#2s);

F_TRIG_62 (CLK := TP_24.Q);

IF F_TRIG_62.Q and OUT_BeltConveyor_6_10 THEN
	SET (OUT =&gt; OUT_Palletizer_2_Open_Plate);
	RESET (OUT =&gt; OUT_Palletizer_2_Clamp);
END_IF;

TP_25 (IN := OUT_Palletizer_2_Open_Plate,
      PT := T#1S);

F_TRIG_63 (CLK := TP_25.Q);

IF F_TRIG_63.Q AND OUT_BeltConveyor_6_10 THEN
	RESET (OUT =&gt; OUT_Palletizer_2_Elevator_Plus);
	SET (OUT =&gt; OUT_Palletizer_2_Elevator_Minus);
END_IF;

TP_26 (IN := OUT_Palletizer_2_Elevator_Minus,
      PT := t#2s);

F_TRIG_64 (CLK := TP_26.Q);

IF F_TRIG_64.Q AND OUT_Palletizer_2_Open_Plate THEN
	RESET (OUT =&gt; OUT_Palletizer_2_Elevator_Minus);
	RESET (OUT =&gt; OUT_Palletizer_2_Open_Plate);
	SET (OUT =&gt; OUT_Roller_Conveyor_F);
	SET (OUT =&gt; OUT_Palletizer_2_Chain_Plus);
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="Stacker_Crane_NF" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Stacker_Crane_NF                                                  *)
(* Almacenamiento de los pallets con las piezas no frágiles                   *)
(* ========================================================================== *)

IF IN_Diffuse_Sensor_21 THEN
	OUT_Roller_Conveyor_NF := 1;
END_IF;

F_TRIG_89 (CLK := IN_Diffuse_Sensor_21);

IF F_TRIG_89.Q THEN
	RESET (OUT =&gt; OUT_Palletizer_1_Chain_Plus);
END_IF;

F_TRIG_48 (CLK := IN_Diffuse_Sensor_20);

IF F_TRIG_48.Q THEN
	OUT_Roller_Conveyor_NF := 0;
	Paso_NF := 0;
END_IF;

TP_33 (IN := F_TRIG_48.Q, PT := T#1S);

F_TRIG_80 (CLK :=TP_33.Q);

IF F_TRIG_80.Q AND Paso_NF = 0 THEN
	OUT_StCr_2_Target_Position := Position_NF;
	Position_NF := Position_NF + 1;
	OUT_Stacker_Crane_2_Lift:= 1;
END_IF;

F_TRIG_81 (CLK := IN_Stacker_Crane_2_Z);

IF F_TRIG_81.Q AND Paso_NF = 0 THEN
	OUT_Stacker_Crane_2_Left := 1;
	Paso_NF := 1;
END_IF;

IF IN_Stacker_Crane_2_Left_Limit and Paso_NF = 1 THEN
	OUT_Stacker_Crane_2_Lift:= 0;
	Paso_NF := 2;
END_IF;
 
IF F_TRIG_81.Q AND Paso_NF = 2  THEN
	OUT_Stacker_Crane_2_Left := 0;
	Paso_NF := 3;
END_IF;

IF IN_Stacker_Crane_2_Middle_Limit and Paso_NF = 3 THEN
	OUT_StCr_2_Target_Position:= 55;
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="Stacker_Crane_F" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Stacker_Crane_F                                                   *)
(* Almacenamiento de los pallets con las piezas  frágiles                     *)
(* ========================================================================== *)

IF IN_Diffuse_Sensor_23 THEN
	OUT_Roller_Conveyor_F := 1;
END_IF;

F_TRIG_90 (CLK := IN_Diffuse_Sensor_23);

IF F_TRIG_90.Q THEN
	RESET (OUT =&gt; OUT_Palletizer_2_Chain_Plus);
END_IF;

F_TRIG_51 (CLK := IN_Diffuse_Sensor_22);

IF F_TRIG_51.Q THEN
	OUT_Roller_Conveyor_F := 0;
	Paso_F := 0;	
END_IF;

TP_35 (IN := F_TRIG_51.Q, PT := T#1S);

F_TRIG_82 (CLK := TP_35.Q);

IF F_TRIG_82.Q AND Paso_F = 0 THEN
	OUT_StCr_3_Target_Position:= Position_F;
	Position_F := Position_F + 1;
	OUT_Stacker_Crane_3_Lift:= 1;
END_IF;

F_TRIG_83 (CLK := IN_Stacker_Crane_3_Z);

IF F_TRIG_83.Q AND Paso_F = 0 THEN
	OUT_Stacker_Crane_3_Left:= 1 ;
	Paso_F := 1;
END_IF;

IF IN_Stacker_Crane_3_Left_Limit AND Paso_F = 1 THEN
	OUT_Stacker_Crane_3_Lift:= 0;
	Paso_F := 2;
END_IF;
 
IF F_TRIG_83.Q AND Paso_F = 2 THEN
	OUT_Stacker_Crane_3_Left:= 0;
	Paso_F := 3;
END_IF;

IF IN_Stacker_Crane_3_Middle_Limit AND Paso_F = 3 THEN
	OUT_StCr_3_Target_Position := 55;
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="Posicionadores_cintas_PP" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Posicionadores_cintas_PP                                          *)
(* Se trata de la colocación de las piezas en cada pick and place junto con   *)
(*  la activación de las cintas siguientes                                    *)	
(* ========================================================================== *)


F_TRIG_0 (CLK := IN_Diffuse_Sensor_12);
F_TRIG_1 (CLK := IN_Diffuse_Sensor_15);
F_TRIG_2 (CLK := IN_Diffuse_Sensor_19);
F_TRIG_3 (CLK := IN_Vision_Sensor_3_Bool_1);
F_TRIG_23 (CLK := IN_Diffuse_Sensor_14);


(* ========================================================================== *)

IF F_TRIG_1.Q THEN
	OUT_Right_Positioner_3_Clamp := TRUE;
END_IF;
IF IN_Right_Positioner_3_Clamped = TRUE THEN
	OUT_Right_Positioner_3_Clamp := FALSE;
END_IF;

(* ========================================================================== *)

IF F_TRIG_0.Q THEN
	OUT_Right_Positioner_1_Clamp := TRUE;
END_IF;
IF IN_Right_Positioner_1_Clamped = TRUE THEN
	OUT_Right_Positioner_1_Clamp := FALSE;
END_IF;

(* ========================================================================== *)

IF  (IN_Vision_Sensor_3_Bool_0 AND IN_Vision_Sensor_3_Bool_3) THEN
	SET(OUT=&gt;OUT_Right_Positioner_2_Raise) ;
END_IF;

IF F_TRIG_2.Q THEN 

RESET(OUT=&gt;OUT_Right_Positioner_2_Raise) ;

END_IF;
IF  (IN_Vision_Sensor_6_Bool_0 AND IN_Vision_Sensor_6_Bool_3) THEN
	SET(OUT=&gt;OUT_Right_Positioner_4_Raise) ;
END_IF;

IF F_TRIG_23.Q THEN 

RESET(OUT=&gt;OUT_Right_Positioner_4_Raise) ;

END_IF;

IF  (IN_Vision_Sensor_3_Bool_0 AND IN_Vision_Sensor_3_Bool_1) THEN
	SET(OUT=&gt;OUT_Right_Positioner_2_Raise) ;
END_IF;

IF F_TRIG_2.Q THEN 

RESET(OUT=&gt;OUT_Right_Positioner_2_Raise) ;

END_IF;

IF IN_Vision_Sensor_6_Bool_2 THEN
	SET(OUT=&gt;OUT_Right_Positioner_4_Raise) ;
END_IF;

IF F_TRIG_23.Q THEN 

RESET(OUT=&gt;OUT_Right_Positioner_4_Raise) ;

END_IF;


(* ========================================================================== *)


IF IN_Vision_Sensor_3_Bool_0 OR IN_Vision_Sensor_3_Bool_1 OR IN_Vision_Sensor_3_Bool_2 OR IN_Vision_Sensor_3_Bool_3 THEN
		OUT_CurvedBeltConveyor5CW:= TRUE;
		OUT_BeltConveyor_4_1:=TRUE;
		OUT_BeltConveyor_6_2 := FALSE;
		OUT_CurvedBeltConveyor3CCW := FALSE;

END_IF;

(* ========================================================================== *)

F_TRIG_70 (CLK := IN_Vision_Sensor_3_Bool_0);
F_TRIG_71 (CLK := IN_Vision_Sensor_3_Bool_1);
F_TRIG_72 (CLK := IN_Vision_Sensor_3_Bool_2);
F_TRIG_73 (CLK := IN_Vision_Sensor_3_Bool_3);

IF F_TRIG_70.Q OR F_TRIG_71.Q OR F_TRIG_72.Q OR F_TRIG_73.Q THEN
	OUT_CurvedBeltConveyor5CW:= TRUE;
	OUT_BeltConveyor_4_1:=TRUE;
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="PP_azul" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: PP_azul                                               	      *)
(* Gestion del pick and place para piezas azules			      *)	
(* ========================================================================== *)

IF IN_Vision_Sensor_3_Bool_0 and IN_Vision_Sensor_3_Bool_1   THEN
	OUT_Emitter5_Emit:= TRUE;
END_IF;
 
IF OUT_Emitter5_Emit THEN
	SET (OUT =&gt; OUT_BeltConveyor_4_7); 
END_IF;

F_TRIG_5 (CLK := IN_Diffuse_Sensor_15);

IF F_TRIG_5.Q THEN
	RESET (OUT =&gt;OUT_BeltConveyor_4_7);
	SET(OUT =&gt; OUT_Two_Axis_Pick_Place_2_Z);
	OUT_Emitter5_Emit:= FAlSE;
END_IF;

R_TRIG_27 (CLK := IN_TwoAxis_PickPlace_2_Detected); 

IF R_TRIG_27.Q THEN 
	SET ( OUT =&gt; OUT_Two_Axis_Pick_Place_2_Grab);

END_IF;
 
R_TRIG_24 (CLK := OUT_Two_Axis_Pick_Place_2_Grab);


IF R_TRIG_24.Q THEN 
	RESET( OUT =&gt; OUT_Two_Axis_Pick_Place_2_Z);
END_IF;
 
F_TRIG_6 (CLK := IN_TwoAxis_PickPlace_2_Moving_Z );

IF F_TRIG_6.Q then
	SET( OUT_Two_Axis_Pick_Place_2_X );
END_IF;

F_TRIG_9 (CLK := IN_Diffuse_Sensor_13);

 
IF OUT_TWO_AXIS_PICK_PLACE_2_X and IN_Right_Positioner_4_Clamped THEN
	SET ( OUT_Two_Axis_Pick_Place_2_Z );
END_IF;

F_TRIG_10 (CLK := IN_TwoAxis_PickPlace_2_Moving_Z);


IF OUT_Two_Axis_Pick_Place_2_Z  and OUT_Two_Axis_Pick_Place_2_X and F_TRIG_10.Q THEN
	RESET (OUT_Two_Axis_Pick_Place_2_Grab);
	RESET( OUT =&gt; OUT_Two_Axis_Pick_Place_2_Z); 
END_IF;
 
IF F_TRIG_9.Q THEN
	SET ( OUT_Right_Positioner_4_Clamp);
END_IF;

F_TRIG_20 (CLK := IN_TwoAxis_PickPlace_2_Moving_Z);

IF F_TRIG_20.Q and OUT_Right_Positioner_4_Clamp THEN
	RESET( OUT =&gt; OUT_Two_Axis_Pick_Place_2_X);
END_IF;

F_TRIG_21 (CLK := IN_TwoAxis_PickPlace_2_Moving_X);

IF  F_TRIG_21.Q AND OUT_Right_Positioner_4_Clamp THEN
	RESET ( OUT_Right_Positioner_4_Clamp);
	SET (OUT_Right_Positioner_4_Raise);
END_IF;

F_TRIG_22 (CLK := IN_Diffuse_Sensor_14);

IF F_TRIG_22.Q THEN 
	RESET(OUT=&gt;OUT_Right_Positioner_4_Raise);
	RESET(OUT=&gt;OUT_Right_Positioner_4_Clamp);
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="PP_verde" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: PP_verde		                                              *)
(* Gestion del pick and place para piezas verdes			      *)
(* ========================================================================== *)

IF IN_Vision_Sensor_1_Bool_2 and IN_Vision_Sensor_1_Bool_1  THEN
OUT_Emitter4_Emit:= TRUE;
END_IF;
 
IF OUT_Emitter4_Emit then
SET (OUT =&gt; OUT_BeltConveyor_4_2); 
END_IF;

F_TRIG_12 (CLK := IN_Diffuse_Sensor_12);

IF F_TRIG_12.Q THEN
RESET (OUT =&gt;OUT_BeltConveyor_4_2);
SET(OUT =&gt; OUT_Two_Axis_Pick_Place_1_Z);
OUT_Emitter4_Emit:= FAlSE;
END_IF;
 

R_TRIG_26 (CLK := IN_TwoAxis_PickPlace_1_Detected );

IF R_TRIG_26.Q THEN 
set ( OUT =&gt; OUT_Two_Axis_Pick_Place_1_Grab);
END_IF;;
 
R_TRIG_25 (CLK := OUT_Two_Axis_Pick_Place_1_Grab);

IF R_TRIG_25.Q THEN 

RESET( OUT =&gt; OUT_Two_Axis_Pick_Place_1_Z);

END_IF;

F_TRIG_13 (CLK := IN_TwoAxis_PickPlace_1_Moving_Z); 

IF F_TRIG_13.Q THEN
Set( OUT_Two_Axis_Pick_Place_1_X );
END_IF;

F_TRIG_14 (CLK := IN_Diffuse_Sensor_18);


IF OUT_TWO_AXIS_PICK_PLACE_1_X AND IN_Right_Positioner_2_Clamped THEN
Set ( OUT_Two_Axis_Pick_Place_1_Z );
END_IF;;

F_TRIG_15 (CLK := IN_TwoAxis_PickPlace_1_Moving_Z);

IF OUT_Two_Axis_Pick_Place_1_Z  AND OUT_Two_Axis_Pick_Place_1_X AND F_TRIG_15.Q then
Reset (OUT_Two_Axis_Pick_Place_1_Grab); 
RESET( OUT =&gt; OUT_Two_Axis_Pick_Place_1_Z);
END_IF;


IF F_TRIG_14.Q THEN
SET ( OUT_Right_Positioner_2_Clamp);
END_IF;



F_TRIG_16 (CLK := IN_TwoAxis_PickPlace_1_Moving_Z);

IF F_TRIG_16.Q AND OUT_Right_Positioner_2_Clamp THEN
RESET( OUT =&gt; OUT_Two_Axis_Pick_Place_1_X);
END_IF;;

F_TRIG_19 (CLK := IN_TwoAxis_PickPlace_1_Moving_X);

IF F_TRIG_19.Q AND OUT_Right_Positioner_2_Clamp THEN

RESET ( OUT_Right_Positioner_2_Clamp);
SET (OUT_Right_Positioner_2_Raise);
END_IF;


F_TRIG_18 (CLK := IN_Diffuse_Sensor_19);

IF F_TRIG_18.Q THEN 
RESET(OUT=&gt;OUT_Right_Positioner_2_Raise);
RESET(OUT=&gt;OUT_Right_Positioner_2_Clamp);
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="Class_Colores" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Class_Colores                                                     *)
(* Cuando pasan las piezas el pick and place, vamos a almacenarla o no por    *)
(* color							              *)	
(* ========================================================================== *)

IF IN_Vision_Sensor_2_Bool_1  THEN
		OUT_BeltConveyor_6_8:=TRUE;
		OUT_Pivot_Arm_Sorter_1_Turn:=TRUE;
		OUT_Pivot_Arm_Sorter_1_Belt_Plus:=TRUE;
		OUT_CurvedBeltConveyor6CW:= true;
		OUT_BeltConveyor_4_6:=TRUE;
	ELSIF IN_Vision_Sensor_2_Bool_2 OR IN_Vision_Sensor_2_Bool_3 THEN
		OUT_BeltConveyor_6_8:=TRUE;
		OUT_CurvedBeltConveyor6CW:= true;
		OUT_Pivot_Arm_Sorter_1_Turn:=FALSE;
		OUT_Pivot_Arm_Sorter_1_Belt_Plus:=FALSE;
		OUT_BeltConveyor_4_6:=TRUE;
		END_IF;

R_TRIG_5 (CLK := IN_Diffuse_Sensor_9);

IF R_TRIG_5.Q THEN
OUT_BeltConveyor_6_9:=TRUE;
END_IF;

R_TRIG_6 (CLK := IN_Diffuse_Sensor_10);

IF R_TRIG_6.Q THEN
	OUT_BeltConveyor_6_11:=TRUE;
END_IF;

IF IN_Vision_Sensor_5_Bool_0 and IN_Vision_Sensor_5_Bool_2  THEN
	OUT_Pivot_Arm_Sorter_2_Turn:=TRUE;
	OUT_Pivot_Arm_Sorter_2_Belt_Plus:=TRUE;

	ELSIF IN_Vision_Sensor_5_Bool_0 or IN_Vision_Sensor_5_Bool_3  THEN

	OUT_Pivot_Arm_Sorter_2_Turn:=false;
	OUT_Pivot_Arm_Sorter_2_Belt_Plus:=false;	
END_IF;

R_TRIG_7 (CLK := IN_Diffuse_Sensor_11);

IF R_TRIG_7.Q THEN
OUT_BeltConveyor_4_3:=TRUE;
OUT_Remover_1_Remove:= TRUE;
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="Pall_Azul" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Pall_Azul                                      	              *)
(* La programación del palletizador de las piezas azules 		      *)
(* ========================================================================== *)  

R_TRIG_8 (CLK := IN_Diffuse_Sensor_16);

IF R_TRIG_8.Q THEN
OUT_BeltConveyor_Inclined_3:=TRUE;
OUT_Palletizer_3_Belt_Plus:=TRUE;
END_IF;

IF OUT_BeltConveyor_Inclined_3 AND OUT_Palletizer_3_Belt_Plus THEN
TON_13 (IN := TRUE, PT := t#10S);
ELSE
TON_13 (IN := FALSE);
END_IF;

IF TON_13.Q THEN
OUT_BeltConveyor_Inclined_3:=FALSE;
OUT_Palletizer_3_Belt_Plus:=FALSE;
cont_azul:= cont_azul+1;  
END_IF;

IF cont_azul=2 THEN
SET (OUT =&gt; OUT_Palletizer_3_Push);
cont_azul:= 0;
SET (OUT =&gt; OUT_Emitter7_Emit);
END_IF;
 
R_TRIG_34 (CLK := IN_Palletizer_3_Pusher_Limit);

IF  R_TRIG_34.Q THEN
RESET (OUT =&gt; OUT_Palletizer_3_Push);
RESET (OUT =&gt; OUT_Emitter7_Emit);
END_IF;

F_TRIG_29 (CLK := OUT_Palletizer_3_Push); 

IF F_TRIG_29.Q and OUT_BeltConveyor_6_10 THEN
SET (OUT =&gt; OUT_Pal_3_Elevator_Move_Limit);
SET (OUT =&gt; OUT_Palletizer_3_Elevator_Plus);
SET (OUT =&gt; OUT_Palletizer_3_Clamp);
END_IF;

TP_2 (IN := F_TRIG_29.Q,
      PT := t#2s);

F_TRIG_27 (CLK := TP_2.Q); 

IF F_TRIG_27.Q and OUT_BeltConveyor_6_10 THEN
SET (OUT =&gt; OUT_Palletizer_3_Open_Plate);
RESET (OUT =&gt; OUT_Palletizer_3_Clamp);
END_IF;

TP_5 (IN := OUT_Palletizer_3_Open_Plate,
      PT := T#1S);

F_TRIG_31 (CLK := TP_5.Q);

IF F_TRIG_31.Q AND OUT_BeltConveyor_6_10 THEN
RESET (OUT =&gt; OUT_Palletizer_3_Elevator_Plus);
SET (OUT =&gt; OUT_Palletizer_3_Elevator_Minus);
END_IF;


TP_3 (IN := OUT_Palletizer_3_Elevator_Minus,
      PT := t#2s);
F_TRIG_25 (CLK := TP_3.Q);

IF F_TRIG_25.Q AND OUT_Palletizer_3_Open_Plate THEN

RESET (OUT =&gt; OUT_Palletizer_3_Elevator_Minus);
RESET (OUT =&gt; OUT_Palletizer_3_Open_Plate);
SET (OUT =&gt; OUT_Roller_Conveyor_A);
SET (OUT =&gt; OUT_Palletizer_3_Chain_Plus);
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="Pall_Verde" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Pall_Verd                                     	              *)
(* La programación del palletizador de las piezas verdes 		      *)
(* ========================================================================== *) 

R_TRIG_28 (CLK := IN_Diffuse_Sensor_17);

IF R_TRIG_28.Q THEN
	OUT_BeltConveyor_Inclined_4:=TRUE;
	OUT_Palletizer_4_Belt_Plus:=TRUE;
END_IF;

IF OUT_BeltConveyor_Inclined_4 AND OUT_Palletizer_4_Belt_Plus THEN
	TON_15 (IN := TRUE, PT := t#10S);
ELSE
	TON_15 (IN := FALSE);
END_IF;

IF TON_15.Q THEN
	OUT_BeltConveyor_Inclined_4:=FALSE;
	OUT_Palletizer_4_Belt_Plus:=FALSE;
	cont_verde:= cont_verde+1; 
END_IF;

IF cont_verde=2 THEN
	SET (OUT =&gt; OUT_Palletizer_4_Push);
	cont_verde:= 0;
	SET (OUT =&gt; OUT_Emitter6_Emit);
END_IF;

IF OUT_Palletizer_4_Push AND OUT_Emitter6_Emit THEN
	TON_16 (IN := TRUE, PT := t#2S);
ELSE
	TON_16 (IN := FALSE);
END_IF;

IF TON_16.Q THEN
	RESET (OUT =&gt; OUT_Palletizer_4_Push);
	RESET (OUT =&gt; OUT_Emitter6_Emit);
END_IF;

F_TRIG_40 (CLK := OUT_Palletizer_4_Push);

IF F_TRIG_40.Q AND OUT_BeltConveyor_6_10 THEN
	SET (OUT =&gt; OUT_Pal_4_Elevator_Move_Limit);
	SET (OUT =&gt; OUT_Palletizer_4_Elevator_Plus);
	SET (OUT =&gt; OUT_Palletizer_4_Clamp);
END_IF;

TP_11 (IN := F_TRIG_40.Q,
       PT := t#2s);

F_TRIG_41 (CLK := TP_11.Q);

IF F_TRIG_41.Q AND OUT_BeltConveyor_6_10 THEN
	SET (OUT =&gt; OUT_Palletizer_4_Open_Plate);
	RESET (OUT =&gt; OUT_Palletizer_4_Clamp);
END_IF;

TP_12 (IN := OUT_Palletizer_4_Open_Plate,
      PT := T#1S);

F_TRIG_42 (CLK := TP_12.Q);

IF F_TRIG_42.Q and OUT_BeltConveyor_6_10 THEN
	RESET (OUT =&gt; OUT_Palletizer_4_Elevator_Plus);
	SET (OUT =&gt; OUT_Palletizer_4_Elevator_Minus);
END_IF;

TP_13 (IN := OUT_Palletizer_4_Elevator_Minus,
      PT := t#2s);

F_TRIG_43 (CLK := TP_13.Q);

IF F_TRIG_43.Q AND OUT_Palletizer_4_Open_Plate THEN
	RESET (OUT =&gt; OUT_Palletizer_4_Elevator_Minus);
	RESET (OUT =&gt; OUT_Palletizer_4_Open_Plate);
	SET (OUT =&gt; OUT_Roller_Conveyor_V);
	SET (OUT =&gt; OUT_Palletizer_4_Chain_Plus);
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="Stacker_Crane_Azul" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Stacker_Crane_Azul                                                *)
(* Almacenamiento de los pallets con las piezas azules en su interior         *)
(* ========================================================================== *)

IF IN_Diffuse_Sensor_24 THEN
	OUT_Roller_Conveyor_A := 1;
END_IF;

F_TRIG_87 (CLK := IN_Diffuse_Sensor_24); 

IF F_TRIG_87.Q THEN
	RESET (OUT =&gt; OUT_Palletizer_3_Chain_Plus);
END_IF;

F_TRIG_84 (CLK := IN_Diffuse_Sensor_25);

IF F_TRIG_84.Q THEN
	OUT_Roller_Conveyor_A := 0;
	Paso := 0;
END_IF;

TP_37 (IN := F_TRIG_84.Q, PT := T#1S);

F_TRIG_86 (CLK := TP_37.Q);

IF Paso = 0 AND F_TRIG_86.Q THEN
	OUT_StCr_1_TargetPosition := Position;
	Position := Position + 1;
	OUT_Stacker_Crane_1_Lift := 1;
END_IF; 

F_TRIG_85 (CLK := IN_Stacker_Crane_1_Z);

IF Paso = 0 AND F_TRIG_85.Q THEN
	OUT_Stacker_Crane_1_Left := 1;
	Paso := 1;	
END_IF;

IF Paso = 1 AND IN_Stacker_Crane_1_Left_Limit = 1 THEN
	OUT_Stacker_Crane_1_Lift := 0;
	Paso := 2;
END_IF;

IF Paso = 2 AND F_TRIG_85.Q THEN
	OUT_Stacker_Crane_1_Left := 0;
	Paso := 3;
END_IF;

IF Paso = 3 AND IN_Stacker_Crane_1_Middle_Limit THEN
	OUT_StCr_1_TargetPosition := 55;
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="Stacker_Crane_Verde" type="SR" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: Stacker_Crane_Verde                                               *)
(* Almacenamiento de los pallets con las piezas verdes en su interior         *)
(* ========================================================================== *)

IF IN_Diffuse_Sensor_4 THEN
	OUT_Roller_Conveyor_V := 1;
END_IF;

F_TRIG_88 (CLK := IN_Diffuse_Sensor_4);

IF F_TRIG_88.Q THEN
	RESET (OUT =&gt; OUT_Palletizer_4_Chain_Plus);
END_IF;

F_TRIG_45 (CLK := IN_Diffuse_Sensor_26);

IF F_TRIG_45.Q THEN
	OUT_Roller_Conveyor_V := 0;
	Paso_V := 0;
END_IF;

TP_29 (IN := F_TRIG_45.Q,
       PT := T#1S);

F_TRIG_77 (CLK := TP_29.Q);


IF Paso_V = 0 AND F_TRIG_77.Q THEN
	OUT_StCr_4_Target_Position := Position_V;
	Position_V := Position_V + 1;
	OUT_Stacker_Crane_4_Lift := 1;
END_IF;

F_TRIG_78 (CLK := IN_Stacker_Crane_4_Z);

IF Paso_V = 0 AND F_TRIG_78.Q THEN
	OUT_Stacker_Crane_4_Left := 1;
	Paso_V:= 1;
END_IF;
 

IF Paso_V = 1 AND IN_Stacker_Crane_4_Left_Limit = 1 THEN
	OUT_Stacker_Crane_4_Lift:= 0;
	Paso_V := 2;
END_IF;


IF Paso_V = 2 AND F_TRIG_78.Q THEN
	OUT_Stacker_Crane_4_Left := 0;
	Paso_V := 3;
END_IF;

IF IN_Stacker_Crane_4_Middle_Limit and Paso_V = 3 THEN
	OUT_StCr_4_Target_Position := 55;
END_IF;
</STSource>
	</program>
	<program>
		<identProgram name="Visual" type="SR" task="MAST"></identProgram>
		<STSource>R_TRIG_13 (CLK := IN_Diffuse_Sensor_16);
R_TRIG_14 (CLK := IN_Diffuse_Sensor_17);
R_TRIG_15 (CLK := IN_Diffuse_Sensor_6);
R_TRIG_16 (CLK := IN_Diffuse_Sensor_11);
R_TRIG_21 (CLK := IN_Light_Array_Emitter_1_Value &gt; 193);
R_TRIG_22 (CLK := IN_Light_Array_Emitter_2_Value &gt; 193);
R_TRIG_19 (CLK := IN_Diffuse_Sensor_7);

IF R_TRIG_13.Q THEN
Contador_azules := Contador_azules + 1;
OUT_Digital_Display_1 := Contador_azules;
END_IF;
 
IF R_TRIG_14.Q THEN
Contador_verdes := Contador_verdes + 1;
OUT_Digital_Display_2:= Contador_verdes;
END_IF;
 
IF R_TRIG_15.Q THEN
Contador_PF := Contador_PF + 1;
END_IF;

IF R_TRIG_16.Q THEN
Contador_gris := Contador_gris + 1;
OUT_Digital_Display_3:= Contador_gris;
END_IF;

IF R_TRIG_21.Q THEN
Contador_F_G := Contador_F_G + 1;
END_IF;

IF R_TRIG_22.Q THEN
Contador_NF_G := Contador_NF_G + 1;
END_IF;

IF R_TRIG_19.Q THEN
Contador_P_nF := Contador_P_nF + 1;
END_IF;


SC_Selector_0 := IN_Selector_1_State_0 ;
SC_Selector_1 := IN_Selector_1_State_1 ;
SC_IN_Emergency_Stop_1 := IN_Emergency_Stop_1;
SC_IN_Reset_Button_1 := IN_Reset_Button_1;
