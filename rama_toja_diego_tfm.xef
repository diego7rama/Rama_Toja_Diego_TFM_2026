	</program>
	<program>
		<identProgram name="Mando" type="section" task="MAST"></identProgram>
		<STSource>(* ========================================================================== *)
(* SECCIÓN: MANDO                                                            *)
(* Control de comandos del operador                                          *)
(* ========================================================================== *)

(* -------------------------------------------------------------------------- *)
(* 1. Interpretación de entradas físicas y HMI                                 *)
(* -------------------------------------------------------------------------- *)

Seguridad_OK := IN_Emergency_Stop_1;      (* TRUE = seta liberada *)
Modo_AUTO := IN_Selector_1_State_1;       (* TRUE = modo automático *)

(* Si el botón STOP es normalmente cerrado, al pulsarlo pasa a FALSE *)
Stop_Pulsado := NOT IN_Stop_Button_1;

(* Mandos físicos + mandos desde HMI *)
Cmd_Start := IN_Start_Button_1 OR HMI_Start;
Cmd_Stop  := Stop_Pulsado OR HMI_Stop;
Cmd_Reset := IN_Reset_Button_1 OR HMI_Reset;


(* -------------------------------------------------------------------------- *)
(* 2. Flancos de mando                                                         *)
(* -------------------------------------------------------------------------- *)

R_TRIG_36 (CLK := Cmd_Start);
R_TRIG_37 (CLK := Cmd_Reset);
TP_40 (IN := R_TRIG_37.Q, PT := T#300MS);


(* -------------------------------------------------------------------------- *)
(* 3. Control de Factory I/O                                                   *)
(* -------------------------------------------------------------------------- *)

OUT_FACTORY_IO_Pause := FALSE;

OUT_FACTORY_IO_Run := TRUE;

OUT_FACTORY_IO_Reset := TP_40.Q;


(* -------------------------------------------------------------------------- *)
(* 4. Gestión GEMMA simplificada                                               *)
(* -------------------------------------------------------------------------- *)
(* 0  = A1 Parada inicial                                                      *)
(* 10 = F1 Producción automática                                               *)
(* 20 = A2 Parada normal                                                       *)
(* 30 = D1 Parada de emergencia                                                *)
(* 40 = A6 Puesta a estado inicial / reset                                     *)
(* -------------------------------------------------------------------------- *)

CASE Estado_GEMMA OF

	0:
		(* A1 - Parada inicial *)
		Marcha_General := FALSE;
		Reset_General := FALSE;
		Mensaje_Sistema := 0;       (* Sistema listo/parado *)

		IF NOT Seguridad_OK THEN
			Estado_GEMMA := 30;

		ELSIF R_TRIG_37.Q THEN
			Estado_GEMMA := 40;

		ELSIF Seguridad_OK AND Modo_AUTO AND R_TRIG_36.Q THEN
			Estado_GEMMA := 10;
		END_IF;


	10:
		(* F1 - Producción automática *)
		Marcha_General := TRUE;
		Reset_General := FALSE;
		Mensaje_Sistema := 10;      (* Producción automática *)

		IF NOT Seguridad_OK THEN
			Estado_GEMMA := 30;

		ELSIF Cmd_Stop THEN
			Estado_GEMMA := 20;

		ELSIF NOT Modo_AUTO THEN
			Estado_GEMMA := 20;

		ELSIF R_TRIG_37.Q THEN
			Estado_GEMMA := 40;
		END_IF;


	20:
		(* A2 - Parada normal *)
		Marcha_General := FALSE;
		Reset_General := FALSE;
		Mensaje_Sistema := 20;      (* Sistema detenido *)

		IF NOT Seguridad_OK THEN
			Estado_GEMMA := 30;

		ELSIF R_TRIG_37.Q THEN
			Estado_GEMMA := 40;

		ELSIF Seguridad_OK AND Modo_AUTO AND R_TRIG_36.Q THEN
			Estado_GEMMA := 10;
		END_IF;


	30:
		(* D1 - Parada de emergencia *)
		Marcha_General := FALSE;
		Reset_General := FALSE;
		Mensaje_Sistema := 30;      (* Emergencia activa *)

		(* Para salir de emergencia: liberar seta + pulsar RESET *)
		IF Seguridad_OK AND R_TRIG_37.Q THEN
			Estado_GEMMA := 40;
		END_IF;


	40:
		(* A6 - Puesta a estado inicial *)
		Marcha_General := FALSE;
		Reset_General := TRUE;
		Mensaje_Sistema := 40;      (* Reset / puesta a cero *)

		Estado_GEMMA := 0;


ELSE
	Estado_GEMMA := 0;
	Marcha_General := FALSE;
	Reset_General := FALSE;
	Mensaje_Sistema := 99;

END_CASE;


(* -------------------------------------------------------------------------- *)
(* 5. Permiso general de proceso                                               *)
(* -------------------------------------------------------------------------- *)

Permiso_Proceso := Seguridad_OK AND Modo_AUTO AND Marcha_General;


(* -------------------------------------------------------------------------- *)
(* 6. Arranque básico de línea                                                 *)
(* -------------------------------------------------------------------------- *)

IF Permiso_Proceso THEN

	OUT_Emitter1_Emit := TRUE;          (* Emisor principal *)
	OUT_BeltConveyor_6_13 := TRUE;      (* Cinta principal *)

END_IF;

(* ========================================================================== *)
(* SECCIÓN: RESET_GENERAL                                                     *)
(* Reinicio de contadores, pasos, posiciones y variables internas             *)
(* ========================================================================== *)

IF Reset_General THEN

	(* ---------------------------------------------------------------------- *)
	(* 1. Contadores principales de visualización                              *)
	(* ---------------------------------------------------------------------- *)

	Contador_verdes := 0;
	Contador_azules := 0;
	Contador_gris := 0;
	Contador_PF := 0;
	Contador_P_nF := 0;
	Contador_NF_G := 0;
	Contador_F_G := 0;

	OUT_Digital_Display_1 := 0;
	OUT_Digital_Display_2 := 0;
	OUT_Digital_Display_3 := 0;


	(* ---------------------------------------------------------------------- *)
	(* 2. Contadores internos de palletizado                                   *)
	(* ---------------------------------------------------------------------- *)

	cont_azul := 0;
	cont_verde := 0;
	cont_F := 0;
	cont_NF := 0;


	(* ---------------------------------------------------------------------- *)
	(* 3. Pasos de secuencia de los stacker cranes                             *)
	(* ---------------------------------------------------------------------- *)

	Paso := 0;
	Paso_V := 0;
	Paso_F := 0;
	Paso_NF := 0;


	(* ---------------------------------------------------------------------- *)
	(* 4. Posiciones de almacenamiento                                         *)
	(* ---------------------------------------------------------------------- *)

	Position := 0;
	Position_V := 0;
	Position_F := 0;
	Position_NF := 0;

	OUT_StCr_1_TargetPosition := 0;
	OUT_StCr_2_Target_Position := 0;
	OUT_StCr_3_Target_Position := 0;
	OUT_StCr_4_Target_Position := 0;


	(* ---------------------------------------------------------------------- *)
	(* 5. FIFO / RFID                                                          *)
	(* ---------------------------------------------------------------------- *)

	SlotRead := 0;
	SlotWrite := 0;
	SlotCount := 0;

	SeqIndex := 0;
	SeqDir := 1;

	RFID_Read_Value := 0;
	Valor_Capturado := 0;

	RFID_READER_1_Executecommand := FALSE;
	RFID_READER_2_Executecommand := FALSE;

	OUT_RFID_Reader_1_Command := 0;
	OUT_RFID_Reader_2_Command := 0;

	OUT_RFID_Reader_1_Memory_Index := 0;
	OUT_RFID_Reader_2_Memory_Index := 0;

	OUT_RFID_Reader_1_Write_Data := 0;
	OUT_RFID_Reader_2_Write_Data := 0;

END_IF;
</STSource>
	</program>
