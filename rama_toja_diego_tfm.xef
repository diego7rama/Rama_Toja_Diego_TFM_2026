	<EFBSource nameOfEFBType="TON" version="1.00" dateTime="dt#2017-07-17-15:26:04">
		<comment>On delay</comment>
		<attribute name="TypeDescriptiveForm" value="  The function block is used as the On delay.  When the function block is called for the first time, the initial state of ET is &quot;0&quot;.&#xA;"></attribute>
		<attribute name="IsTypeHidden" value="FALSE"></attribute>
		<attribute name="IsTypeDiagnostic" value="FALSE"></attribute>
		<attribute name="TypeCodeCheckSumString" value="B257"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="16D2"></attribute>
		<ExternalToolsOnly>
			<inputParameters>
				<variables name="IN" typeName="BOOL">
					<comment>Start delay</comment>
					<attribute name="PositionPin" value="1"></attribute>
					<attribute name="IsPinDiagnosticable" value="0"></attribute>
				</variables>
				<variables name="PT" typeName="TIME">
					<comment>Preset delay time</comment>
					<attribute name="PositionPin" value="2"></attribute>
				</variables>
			</inputParameters>
			<outputParameters>
				<variables name="Q" typeName="BOOL">
					<comment>Delayed output</comment>
					<attribute name="PositionPin" value="1"></attribute>
				</variables>
				<variables name="ET" typeName="TIME">
					<comment>Internal time</comment>
					<attribute name="PositionPin" value="2"></attribute>
				</variables>
			</outputParameters>
		</ExternalToolsOnly>
	</EFBSource>
	<EFBSource nameOfEFBType="F_TRIG" version="1.00" dateTime="dt#2017-07-17-15:53:52">
		<comment>Falling edge detection</comment>
		<attribute name="TypeDescriptiveForm" value="  This function block is used for the detection of falling edges 1 -&gt; 0.&#xA;  Output Q becomes &quot;1&quot; if there is a transition from &quot;1&quot; to &quot;0&quot; at the CLK input.&#xA;  The output will remain at &quot;1&quot; from one function block execution to the next;&#xA;  the output subsequently returns to &quot;0&quot;.&#xA;&#xA;  Note: This function block is not available in the LD (Ladder Diagram) programming language,&#xA;        since the same functionality can be achieved there with the &quot;Contact - negative edge&quot;.&#xA;"></attribute>
		<attribute name="IsTypeHidden" value="FALSE"></attribute>
		<attribute name="IsTypeDiagnostic" value="FALSE"></attribute>
		<attribute name="TypeCodeCheckSumString" value="D0FC"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="576B"></attribute>
		<ExternalToolsOnly>
			<inputParameters>
				<variables name="CLK" typeName="BOOL">
					<comment>Clock input</comment>
					<attribute name="PositionPin" value="1"></attribute>
					<attribute name="IsPinDiagnosticable" value="0"></attribute>
				</variables>
			</inputParameters>
			<outputParameters>
				<variables name="Q" typeName="BOOL">
					<comment>Output</comment>
					<attribute name="PositionPin" value="1"></attribute>
				</variables>
			</outputParameters>
		</ExternalToolsOnly>
	</EFBSource>
	<EFSource nameOfEFType="CLEARCHART" version="1.00" dateTime="dt#2017-07-17-15:45:07">
		<comment>Reset all active steps of a SFC Chart</comment>
		<attribute name="TypeDescriptiveForm" value="  This function is used to reset all active steps.&#xA;  Danger: CLEARCHART should not be used for error detection on controllers for machine&#xA;          tools or, processing or material handling systems when they are running.&#xA;          Failure to observe this precaution could result in death or serious injury.&#xA;&#xA;  If a rising edge at CLEAR_I is detected, all active steps will be stopped and reset.&#xA;  This status is maintained as long as the input CLEAR_I is true. It will even be maintained after&#xA;  setting CLEAR_I to false. The situation is shown at the output (CLEAR_O = 1).&#xA;&#xA;  Once CLEAR_I is set to 0, the steps can be activated by the EFB SFCCNTRL (input INIT),&#xA;  the function INITCHART or some other step-activation command (externally).&#xA;&#xA;  Note: Output CLEAR_O shows the actual state of the chart. It may be reset by EFB SFCCNTRL,&#xA;        the function INITCHART, the procedure RESETSTEP or some other command (externally).&#xA;"></attribute>
		<attribute name="IsTypeHidden" value="FALSE"></attribute>
		<attribute name="TypeCodeCheckSumString" value="F9F1"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="E9CE"></attribute>
		<ExternalToolsOnly>
			<inputParameters>
				<variables name="CHARTREF" typeName="SFCCHART_STATE">
					<comment>Link to SFC-chart</comment>
					<attribute name="PositionPin" value="1"></attribute>
				</variables>
				<variables name="CLEAR_I" typeName="BOOL">
					<comment>0-&gt;1: Reset a SFC Chart</comment>
					<attribute name="PositionPin" value="2"></attribute>
				</variables>
			</inputParameters>
			<outputParameters>
				<variables name="CLEAR_O" typeName="BOOL">
					<comment>Chart was reset, no active step</comment>
					<attribute name="PositionPin" value="2"></attribute>
				</variables>
			</outputParameters>
		</ExternalToolsOnly>
	</EFSource>
	<EFSource nameOfEFType="INITCHART" version="1.00" dateTime="dt#2017-07-17-15:45:07">
		<comment>reset all active steps, standardises start of chart</comment>
		<attribute name="TypeDescriptiveForm" value="  This function is used to reset all active steps and standardises starts of charts.&#xA;  Danger: INITCHART should not be used for error detection on controllers for machine&#xA;          tools or, process or material handling systems when they are running.&#xA;          Failure to observe this precaution could result in death or serious injury.&#xA;&#xA;  Note: INITCHART has the highest priority of all EFs and EFBs controlling SFC charts.&#xA;&#xA;  If the input INIT_I=1, the chart is stopped and all active steps are reset.&#xA;  This situation is maintained as long as the input INIT_I is true.&#xA;  On a falling edge at INIT_I the chart will be started in standardized status.&#xA;  Output INIT_O will indicate this for one scan.&#xA;&#xA;  Note: Output INIT_O shows the actual state of the chart but the chart may also be&#xA;        started by EFB SFCCNTRL or some other command (externally).&#xA;"></attribute>
		<attribute name="IsTypeHidden" value="FALSE"></attribute>
		<attribute name="TypeCodeCheckSumString" value="0DBF"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="E7F5"></attribute>
		<ExternalToolsOnly>
			<inputParameters>
				<variables name="CHARTREF" typeName="SFCCHART_STATE">
					<comment>Link to SFC-chart</comment>
					<attribute name="PositionPin" value="1"></attribute>
				</variables>
				<variables name="INIT_I" typeName="BOOL">
					<comment>Reset and start a SFC Chart</comment>
					<attribute name="PositionPin" value="2"></attribute>
				</variables>
			</inputParameters>
			<outputParameters>
				<variables name="INIT_O" typeName="BOOL">
					<comment>Show value of INIT_I in effect</comment>
					<attribute name="PositionPin" value="2"></attribute>
				</variables>
			</outputParameters>
		</ExternalToolsOnly>
	</EFSource>
	<EFBSource nameOfEFBType="DELAY" version="1.00" dateTime="dt#2017-07-17-16:16:40">
		<comment>Deadtime device</comment>
		<attribute name="TypeDescriptiveForm" value="  With this function block the input signal is delayed by a deadtime.  The function block delays the signal X by the deadtime T_DELAY before it appears again at Y.&#xA;  The function block incorporates a delay buffer for 128 elements (X values), meaning that&#xA;  during the time span T_DELAY 128 X values can be stored. The buffer is used in such a way&#xA;  that it corresponds with the operating mode.&#xA;  The value of the Y output remains unchanged after cold and warm system starts.&#xA;  The internal values are set to the value of X.&#xA;  After a change of deadtime T_DELAY or a cold or warm system start, the output READY goes to &quot;0&quot;.&#xA;  This means: that the buffer is not ready because it is empty.&#xA;  The function block has the following operating mode: Manual, halt and automatic mode.&#xA;  REMARK: The delay time continues to run even if the block is disabled via the EN parameter,&#xA;          because the block calculates its time differences according to the system clock.&#xA;"></attribute>
		<attribute name="IsTypeHidden" value="FALSE"></attribute>
		<attribute name="IsTypeDiagnostic" value="FALSE"></attribute>
		<attribute name="TypeCodeCheckSumString" value="451C"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="5B19"></attribute>
		<ExternalToolsOnly>
			<inputParameters>
				<variables name="MAN" typeName="BOOL">
					<comment>1: Manual operating mode</comment>
					<attribute name="PositionPin" value="1"></attribute>
					<attribute name="IsPinDiagnosticable" value="0"></attribute>
				</variables>
				<variables name="HALT" typeName="BOOL">
					<comment>1: Halt mode</comment>
					<attribute name="PositionPin" value="2"></attribute>
					<attribute name="IsPinDiagnosticable" value="0"></attribute>
				</variables>
				<variables name="X" typeName="REAL">
					<comment>Input</comment>
					<attribute name="PositionPin" value="3"></attribute>
				</variables>
				<variables name="T_DELAY" typeName="TIME">
					<comment>Dead time delay constant</comment>
					<attribute name="PositionPin" value="4"></attribute>
				</variables>
				<variables name="YMAN" typeName="REAL">
					<comment>Manually manipulated value</comment>
					<attribute name="PositionPin" value="5"></attribute>
				</variables>
			</inputParameters>
			<outputParameters>
				<variables name="Y" typeName="REAL">
					<comment>Output</comment>
					<attribute name="PositionPin" value="3"></attribute>
				</variables>
				<variables name="READY" typeName="BOOL">
					<comment>Delay buffer ready</comment>
					<attribute name="PositionPin" value="4"></attribute>
				</variables>
			</outputParameters>
		</ExternalToolsOnly>
	</EFBSource>
	<EFSource nameOfEFType="SETSTEP" version="1.00" dateTime="dt#2017-07-17-15:45:07">
		<comment>Set one Step in a SFC Chart</comment>
		<attribute name="TypeDescriptiveForm" value="  This procedure is used to set a step in a chart.&#xA;  Danger: SETSTEP should not be used for error detection on controllers for machine&#xA;          tool or, process or material handling systems when they are running.&#xA;          Failure to observe this precaution could result in death or serious injury.&#xA;&#xA;  Note: This procedure may only be invoked in &quot;Multi-Token&quot; mode.&#xA;&#xA;  The step remains set as long as the procedure is processed.&#xA;"></attribute>
		<attribute name="IsTypeHidden" value="FALSE"></attribute>
		<attribute name="TypeCodeCheckSumString" value="C008"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="290D"></attribute>
		<ExternalToolsOnly>
			<inputParameters>
				<variables name="STEPNAME" typeName="SFCSTEP_STATE">
					<comment>Step to set</comment>
					<attribute name="PositionPin" value="1"></attribute>
				</variables>
				<variables name="CHARTREF" typeName="SFCCHART_STATE">
					<attribute name="PositionPin" value="2"></attribute>
					<attribute name="IsVariableHidden" value="-1"></attribute>
				</variables>
			</inputParameters>
		</ExternalToolsOnly>
	</EFSource>
	<EFBSource nameOfEFBType="TP" version="1.00" dateTime="dt#2017-07-17-15:26:04">
		<comment>Pulse</comment>
		<attribute name="TypeDescriptiveForm" value="  The function block is used for the generation of a pulse with defined duration.  When the function block is called for the first time, the initial state of ET is &quot;0&quot;.&#xA;"></attribute>
		<attribute name="IsTypeHidden" value="FALSE"></attribute>
		<attribute name="IsTypeDiagnostic" value="FALSE"></attribute>
		<attribute name="TypeCodeCheckSumString" value="C1F7"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="16D2"></attribute>
		<ExternalToolsOnly>
			<inputParameters>
				<variables name="IN" typeName="BOOL">
					<comment>Trigger pulse</comment>
					<attribute name="PositionPin" value="1"></attribute>
					<attribute name="IsPinDiagnosticable" value="0"></attribute>
				</variables>
				<variables name="PT" typeName="TIME">
					<comment>Preset pulse duration</comment>
