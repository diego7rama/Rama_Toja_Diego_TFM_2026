SC_OUT_BeltConveyor_4_6 := OUT_BeltConveyor_4_6;

SC_OUT_Two_Axis_Pick_Place_1_X := OUT_Two_Axis_Pick_Place_1_X;
SC_OUT_Two_Axis_Pick_Place_1_Z := OUT_Two_Axis_Pick_Place_1_Z;
SC_OUT_Two_Axis_Pick_Place_2_X := OUT_Two_Axis_Pick_Place_2_X;
SC_OUT_Two_Axis_Pick_Place_2_Z := OUT_Two_Axis_Pick_Place_2_Z;

SC_OUT_Two_Axis_PP_1_Grab := OUT_Two_Axis_Pick_Place_1_Grab;
SC_OUT_Two_Axis_PP_2_Grab := OUT_Two_Axis_Pick_Place_2_Grab;

SC_OUT_Emitter4_Emit := OUT_Emitter4_Emit;
SC_OUT_Emitter5_Emit := OUT_Emitter5_Emit;

SC_OUT_Roller_Conveyor_V:=OUT_Roller_Conveyor_V;
SC_OUT_Roller_Conveyor_A:=OUT_Roller_Conveyor_A;
SC_OUT_Roller_Conveyor_F:=OUT_Roller_Conveyor_F;
SC_OUT_Roller_Conveyor_NF:=OUT_Roller_Conveyor_NF;

(* ========================================================================== *)
(* VARIABLES SCADA ADICIONALES - MANDO / GEMMA / ESTADO GENERAL               *)
(* ========================================================================== *)

SC_Estado_GEMMA := Estado_GEMMA;
SC_Mensaje_Sistema := Mensaje_Sistema;

SC_Marcha_General := Marcha_General;
SC_Permiso_Proceso := Permiso_Proceso;
SC_Seguridad_OK := Seguridad_OK;
